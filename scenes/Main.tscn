[sub_resource type="GDScript" id="GDScript_elqb8"]
script/source = "extends Node2D

var board: Board
var game_client: GameClient
var consola: MockServerConsole

var jugadores_demo := [
	{\"id\": \"JUGADOR1\", \"color\": Color(\"#1E88E5\")},  # azul
	{\"id\": \"JUGADOR2\", \"color\": Color(\"#FB8C00\")},  # naranja
	{\"id\": \"JUGADOR3\", \"color\": Color(\"#43A047\")},  # verde
	{\"id\": \"JUGADOR4\", \"color\": Color(\"#8E24AA\")},  # morado
]

func _ready() -> void:
	board = Board.new()
	add_child(board)
	board.position = Vector2(120, 60)

	game_client = GameClient.new()
	add_child(game_client)
	game_client.inicializar(board)

	_crear_jugadores_demo()
	
	# DEBUG:
	consola = MockServerConsole.new()
	add_child(consola)
	consola.mensaje_enviado.connect(_on_mensaje_mock)

	# Cuando el servidor real ya exista y tenga protocolo acordado,
	# descomentar esto:
	# game_client.conectar_a_servidor(\"127.0.0.1\", 5000)

func _crear_jugadores_demo() -> void:
	for i in jugadores_demo.size():
		var datos = jugadores_demo[i]
		var token := PlayerToken.new()
		board.add_child(token)
		token.inicializar(datos.id, i, datos.color, board, 0)
		game_client.registrar_jugador(datos.id, token)

	# Los 4 arrancan en la casilla 0, así que se reparten de una
	game_client.reacomodar_todo()

func _on_mensaje_mock(mensaje: String) -> void:
	game_client.procesar_mensaje(mensaje)
"

